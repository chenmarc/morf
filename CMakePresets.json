{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Plugin, app and tools for this computer",
      "description": "Builds for the machine you're on: Intel Mac, Apple silicon Mac, Windows or Linux.",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": { "MORF_BUILD_PLUGIN": "ON", "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "mac-universal",
      "inherits": "default",
      "displayName": "macOS universal (Intel + Apple silicon)",
      "description": "One binary that runs natively on both kinds of Mac. Slower to build.",
      "binaryDir": "${sourceDir}/build-universal",
      "cacheVariables": { "MORF_MAC_UNIVERSAL": "ON" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "bench",
      "displayName": "Engine, tools and tests only (no JUCE download)",
      "binaryDir": "${sourceDir}/build-bench",
      "cacheVariables": { "MORF_BUILD_PLUGIN": "OFF", "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default", "configuration": "Release" },
    { "name": "mac-universal", "configurePreset": "mac-universal", "configuration": "Release" },
    { "name": "bench", "configurePreset": "bench", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "default", "configurePreset": "default", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "mac-universal", "configurePreset": "mac-universal", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "bench", "configurePreset": "bench", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
